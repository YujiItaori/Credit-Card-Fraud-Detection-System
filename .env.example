# ---------------------------------------------------------------------------
# Credit Card Fraud Detection - environment configuration example
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust values for your local environment.
# Do not commit `.env` to version control.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# FastAPI service
# ---------------------------------------------------------------------------

# Host used by Uvicorn when starting the API.
# Local development default:
FRAUD_API_HOST=127.0.0.1

# Port used by Uvicorn when starting the API.
# Local development default:
FRAUD_API_PORT=8000

# Controls whether Uvicorn reloads when source files change.
# Use true only during development.
FRAUD_API_RELOAD=true


# ---------------------------------------------------------------------------
# Streamlit API client
# ---------------------------------------------------------------------------

# Base URL used by the Streamlit application to reach the FastAPI service.
# For local development, this should match FRAUD_API_HOST and FRAUD_API_PORT.
FRAUD_API_BASE_URL=http://127.0.0.1:8000

# Request timeout, in seconds, used by the Streamlit API client.
FRAUD_API_TIMEOUT_SECONDS=30


# ---------------------------------------------------------------------------
# Model artifacts
# ---------------------------------------------------------------------------

# Directory containing trained supervised and anomaly-model artifacts.
MODEL_ARTIFACTS_DIR=models

# Optional override for the supervised-model artifact path.
# Leave blank to use the default artifact path inside MODEL_ARTIFACTS_DIR.
SUPERVISED_MODEL_PATH=

# Optional override for the anomaly-model artifact path.
# Leave blank to use the default artifact path inside MODEL_ARTIFACTS_DIR.
ANOMALY_MODEL_PATH=